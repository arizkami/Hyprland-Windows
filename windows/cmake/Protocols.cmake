# Wayland protocol C++ bindings, generated by hyprwayland-scanner exactly as the
# Linux build does. The protocol list is read from the root CMakeLists.txt
# (protocolnew/protocolWayland calls), so both builds stay in sync.
# Headers are needed to compile shared code; the generated .cpp files need
# libwayland-server and are not built yet.

hypr_fetch(hyprwayland-scanner https://github.com/hyprwm/hyprwayland-scanner.git 62e62c1ca23da17612c6890d4ad2064f575643db)
find_package(pugixml CONFIG REQUIRED)
add_executable(hyprwayland-scanner "${hyprwayland-scanner_SOURCE_DIR}/src/main.cpp")
target_compile_features(hyprwayland-scanner PRIVATE cxx_std_23)
target_compile_options(hyprwayland-scanner PRIVATE ${HYPR_THIRD_PARTY_OPTIONS})
hypr_version(hyprwayland-scanner HYPRWAYLAND_SCANNER_VERSION)
target_compile_definitions(hyprwayland-scanner PRIVATE SCANNER_VERSION="${HYPRWAYLAND_SCANNER_VERSION}" NOMINMAX)
target_link_libraries(hyprwayland-scanner PRIVATE pugixml::pugixml)

FetchContent_Declare(wayland-protocols
    GIT_REPOSITORY https://gitlab.freedesktop.org/wayland/wayland-protocols.git
    GIT_TAG 1.49
    GIT_SHALLOW TRUE
    GIT_CONFIG core.autocrlf=false
    SOURCE_SUBDIR windows-no-cmake)
FetchContent_MakeAvailable(wayland-protocols)

# Same location as the Linux build (gitignored); some sources include them relatively.
set(HYPRLAND_PROTOCOL_DIR "${HYPRLAND_SOURCE_DIR}/protocols")
file(MAKE_DIRECTORY "${HYPRLAND_PROTOCOL_DIR}")
set(HYPRLAND_PROTOCOL_HEADERS "")
set(HYPRLAND_PROTOCOL_SOURCES "")

function(hyprland_protocol xml name)
    set(output "${HYPRLAND_PROTOCOL_DIR}/${name}")
    add_custom_command(
        OUTPUT "${output}.hpp" "${output}.cpp"
        COMMAND hyprwayland-scanner ${ARGN} "${xml}" "${HYPRLAND_PROTOCOL_DIR}/"
        DEPENDS hyprwayland-scanner "${xml}"
        COMMENT "Generating ${name} protocol bindings"
        VERBATIM)
    set(HYPRLAND_PROTOCOL_HEADERS ${HYPRLAND_PROTOCOL_HEADERS} "${output}.hpp" PARENT_SCOPE)
    set(HYPRLAND_PROTOCOL_SOURCES ${HYPRLAND_PROTOCOL_SOURCES} "${output}.cpp" PARENT_SCOPE)
endfunction()

file(READ "${HYPRLAND_SOURCE_DIR}/CMakeLists.txt" HYPRLAND_ROOT_CMAKE)
string(REGEX MATCHALL "protocolnew\\([ \t\r\n]*\"[^\"]+\"[ \t\r\n]+\"[^\"]+\"[ \t\r\n]*(true|false)[ \t\r\n]*\\)" HYPRLAND_PROTOCOL_CALLS "${HYPRLAND_ROOT_CMAKE}")
if(NOT HYPRLAND_PROTOCOL_CALLS)
    message(FATAL_ERROR "No protocolnew() calls found in ${HYPRLAND_SOURCE_DIR}/CMakeLists.txt")
endif()
foreach(call IN LISTS HYPRLAND_PROTOCOL_CALLS)
    string(REGEX REPLACE "protocolnew\\([ \t\r\n]*\"([^\"]+)\"[ \t\r\n]+\"([^\"]+)\"[ \t\r\n]*(true|false).*" "\\1;\\2;\\3" parts "${call}")
    list(GET parts 0 path)
    list(GET parts 1 name)
    list(GET parts 2 external)
    string(REPLACE "\${HYPRLAND_PROTOCOLS}" "${HYPRLAND_SOURCE_DIR}/subprojects/hyprland-protocols" path "${path}")
    if(external)
        if(NOT IS_ABSOLUTE "${path}")
            set(path "${HYPRLAND_SOURCE_DIR}/${path}")
        endif()
    else()
        set(path "${wayland-protocols_SOURCE_DIR}/${path}")
    endif()
    hyprland_protocol("${path}/${name}.xml" "${name}")
endforeach()
hyprland_protocol("${wayland_SOURCE_DIR}/protocol/wayland.xml" wayland --wayland-enums)

list(LENGTH HYPRLAND_PROTOCOL_HEADERS HYPRLAND_PROTOCOL_COUNT)
message(STATUS "Generating ${HYPRLAND_PROTOCOL_COUNT} Wayland protocol bindings")
add_custom_target(hyprland_protocol_headers DEPENDS ${HYPRLAND_PROTOCOL_HEADERS})
add_library(hyprland_protocols_interface INTERFACE)
target_include_directories(hyprland_protocols_interface INTERFACE "${HYPRLAND_PROTOCOL_DIR}")
add_dependencies(hyprland_protocols_interface hyprland_protocol_headers)
