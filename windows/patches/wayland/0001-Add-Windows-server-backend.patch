+/*
+ * Windows implementation of the wl_event_loop API (event-loop.c is epoll based).
+ *
+ * Sources wait on kernel handles with MsgWaitForMultipleObjectsEx:
+ *  - fd sources: CRT descriptors whose OS handle is waitable (signaled = readable)
+ *  - handle sources (wl_event_loop_add_handle): any waitable HANDLE
+ *  - one message source (wl_event_loop_add_win32_messages): the thread's message queue
+ *  - signal sources: CRT signal() handlers that set a flag and wake the loop
+ * Timers keep deadlines on the QueryPerformanceCounter clock and bound the wait.
+ * Idle, check and destroy lists follow event-loop.c exactly.
+ */
+
+#ifdef _WIN32
+
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <io.h>
+/* Some SDK headers define interface as a keyword alias; libwayland uses it as a name. */
+#undef interface
+#include <errno.h>
+#include <signal.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "wayland-util.h"
+#include "wayland-private.h"
+#include "wayland-server-core.h"
+#include "wayland-server-private.h"
+
+/* MsgWaitForMultipleObjectsEx waits on at most MAXIMUM_WAIT_OBJECTS - 1 handles. */
+#define WL_WIN32_MAX_HANDLES (MAXIMUM_WAIT_OBJECTS - 1)
+#define WL_WIN32_SIGNALS     NSIG
+
+enum wl_win32_source_kind {
+	WL_WIN32_SOURCE_FD,
+	WL_WIN32_SOURCE_HANDLE,
+	WL_WIN32_SOURCE_TIMER,
+	WL_WIN32_SOURCE_SIGNAL,
+	WL_WIN32_SOURCE_IDLE,
+	WL_WIN32_SOURCE_MESSAGES,
+};
+
+struct wl_event_source {
+	enum wl_win32_source_kind kind;
+	struct wl_event_loop *loop;
+	struct wl_list link;       /* idle, check or destroy list */
+	struct wl_list loop_link;  /* loop->sources; empty once removed */
+	void *data;
+	bool removed;
+	bool due;                  /* timers: collected for the current dispatch pass */
+	int64_t due_deadline;      /* timers: deadline that made it due, for ordering */
+	HANDLE handle;
+	int fd;
+	uint32_t mask;
+	int64_t deadline;          /* timers: QPC ticks, 0 = disarmed */
+	int signal_number;
+	union {
+		wl_event_loop_fd_func_t fd;
+		wl_event_loop_handle_func_t handle;
+		wl_event_loop_timer_func_t timer;
+		wl_event_loop_signal_func_t signal;
+		wl_event_loop_idle_func_t idle;
+	} func;
+};
+
+struct wl_event_loop {
+	struct wl_list sources;
+	struct wl_list check_list;
+	struct wl_list idle_list;
+	struct wl_list destroy_list;
+	struct wl_event_source *messages;
+	HANDLE wake;
+	/* Waitable timer armed for the earliest timer source. A high-resolution
+	 * timer avoids the ~15 ms granularity of wait timeouts. */
+	HANDLE timer;
+	struct wl_priv_signal destroy_signal;
+};
+
+/* CRT signal handlers cannot carry context; pending signals wake every loop. */
+static volatile LONG pending_signals[WL_WIN32_SIGNALS];
+static HANDLE signal_wake;
+
+static int64_t
+qpc_now(void)
+{
+	LARGE_INTEGER now;
+	QueryPerformanceCounter(&now);
+	return now.QuadPart;
+}
+
+static int64_t
+qpc_frequency(void)
+{
+	static int64_t frequency;
+	if (!frequency) {
+		LARGE_INTEGER value;
+		QueryPerformanceFrequency(&value);
+		frequency = value.QuadPart;
+	}
+	return frequency;
+}
+
+static struct wl_event_source *
+source_create(struct wl_event_loop *loop, enum wl_win32_source_kind kind, void *data)
+{
+	struct wl_event_source *source = zalloc(sizeof *source);
+	if (!source)
+		return NULL;
+	source->kind = kind;
+	source->loop = loop;
+	source->data = data;
+	source->fd = -1;
+	wl_list_init(&source->link);
+	wl_list_insert(loop->sources.prev, &source->loop_link);
+	return source;
+}
+
+static size_t
+count_waitable(struct wl_event_loop *loop)
+{
+	struct wl_event_source *source;
+	size_t count = 0;
+
+	wl_list_for_each(source, &loop->sources, loop_link) {
+		if (!source->removed && source->handle && source->mask)
+			count++;
+	}
+	return count;
+}
+
+static struct wl_event_source *
+add_waitable(struct wl_event_loop *loop, enum wl_win32_source_kind kind, HANDLE handle, uint32_t mask, void *data)
+{
+	if (!handle || handle == INVALID_HANDLE_VALUE) {
+		errno = EBADF;
+		return NULL;
+	}
+	/* The loop reserves slots for its wake event, timer and signal event. */
+	if (mask && count_waitable(loop) >= WL_WIN32_MAX_HANDLES - 3) {
+		errno = EMFILE;
+		return NULL;
+	}
+
+	struct wl_event_source *source = source_create(loop, kind, data);
+	if (!source)
+		return NULL;
+	source->handle = handle;
+	source->mask = mask;
+	return source;
+}
+
+WL_EXPORT struct wl_event_source *
+wl_event_loop_add_fd(struct wl_event_loop *loop,
+		     int fd, uint32_t mask,
+		     wl_event_loop_fd_func_t func,
+		     void *data)
+{
+	/* The source owns its fd, as in event-loop.c (which dups it). */
+	int owned = _dup(fd);
+	if (owned < 0)
+		return NULL;
+
+	HANDLE handle = (HANDLE)_get_osfhandle(owned);
+	struct wl_event_source *source = add_waitable(loop, WL_WIN32_SOURCE_FD, handle, mask, data);
+	if (!source) {
+		_close(owned);
+		return NULL;
+	}
+	source->fd = owned;
+	source->func.fd = func;
+	return source;
+}
+
+WL_EXPORT int
+wl_event_source_fd_update(struct wl_event_source *source, uint32_t mask)
+{
+	if (source->kind != WL_WIN32_SOURCE_FD) {
+		errno = EINVAL;
+		return -1;
+	}
+	source->mask = mask;
+	return 0;
+}
+
+WL_EXPORT struct wl_event_source *
+wl_event_loop_add_handle(struct wl_event_loop *loop,
+			 void *handle,
+			 wl_event_loop_handle_func_t func,
+			 void *data)
+{
+	struct wl_event_source *source = add_waitable(loop, WL_WIN32_SOURCE_HANDLE, handle, WL_EVENT_READABLE, data);
+	if (source)
+		source->func.handle = func;
+	return source;
+}
+
+WL_EXPORT struct wl_event_source *
+wl_event_loop_add_win32_messages(struct wl_event_loop *loop,
+				 wl_event_loop_idle_func_t func,
+				 void *data)
+{
+	if (loop->messages) {
+		errno = EBUSY;
+		return NULL;
+	}
+	struct wl_event_source *source = source_create(loop, WL_WIN32_SOURCE_MESSAGES, data);
+	if (!source)
+		return NULL;
+	source->func.idle = func;
+	loop->messages = source;
+	return source;
+}
+
+WL_EXPORT struct wl_event_source *
+wl_event_loop_add_timer(struct wl_event_loop *loop,
+			wl_event_loop_timer_func_t func,
+			void *data)
+{
+	struct wl_event_source *source = source_create(loop, WL_WIN32_SOURCE_TIMER, data);
+	if (source)
+		source->func.timer = func;
+	return source;
+}
+
+WL_EXPORT int
+wl_event_source_timer_update(struct wl_event_source *source, int ms_delay)
+{
+	if (source->kind != WL_WIN32_SOURCE_TIMER) {
+		errno = EINVAL;
+		return -1;
+	}
+	if (ms_delay > 0)
+		source->deadline = qpc_now() + (int64_t)ms_delay * qpc_frequency() / 1000;
+	else
+		source->deadline = 0;
+	return 0;
+}
+
+static void
+signal_handler(int signal_number)
+{
+	/* The CRT resets the disposition before calling the handler. */
+	signal(signal_number, signal_handler);
+	if (signal_number < 0 || signal_number >= WL_WIN32_SIGNALS)
+		return;
+	InterlockedExchange(&pending_signals[signal_number], 1);
+	if (signal_wake)
+		SetEvent(signal_wake);
+}
+
+WL_EXPORT struct wl_event_source *
+wl_event_loop_add_signal(struct wl_event_loop *loop,
+			 int signal_number,
+			 wl_event_loop_signal_func_t func,
+			 void *data)
+{
+	if (signal_number < 0 || signal_number >= WL_WIN32_SIGNALS) {
+		errno = EINVAL;
+		return NULL;
+	}
+	if (!signal_wake) {
+		signal_wake = CreateEventW(NULL, TRUE, FALSE, NULL);
+		if (!signal_wake)
+			return NULL;
+	}
+	if (signal(signal_number, signal_handler) == SIG_ERR)
+		return NULL;
+
+	struct wl_event_source *source = source_create(loop, WL_WIN32_SOURCE_SIGNAL, data);
+	if (!source)
+		return NULL;
+	source->signal_number = signal_number;
+	source->func.signal = func;
+	return source;
+}
+
+WL_EXPORT struct wl_event_source *
+wl_event_loop_add_idle(struct wl_event_loop *loop,
+		       wl_event_loop_idle_func_t func,
+		       void *data)
+{
+	struct wl_event_source *source = zalloc(sizeof *source);
+	if (!source)
+		return NULL;
+	source->kind = WL_WIN32_SOURCE_IDLE;
+	source->loop = loop;
+	source->data = data;
+	source->fd = -1;
+	source->func.idle = func;
+	wl_list_init(&source->loop_link);
+	wl_list_insert(loop->idle_list.prev, &source->link);
+	return source;
+}
+
+WL_EXPORT void
+wl_event_source_check(struct wl_event_source *source)
+{
+	wl_list_insert(source->loop->check_list.prev, &source->link);
+}
+
+WL_EXPORT int
+wl_event_source_remove(struct wl_event_source *source)
+{
+	struct wl_event_loop *loop = source->loop;
+
+	if (source->kind == WL_WIN32_SOURCE_FD && source->fd >= 0) {
+		_close(source->fd);
+		source->fd = -1;
+	}
+	if (source->kind == WL_WIN32_SOURCE_SIGNAL) {
+		bool shared = false;
+		struct wl_event_source *other;
+		wl_list_for_each(other, &loop->sources, loop_link) {
+			if (other != source && !other->removed && other->kind == WL_WIN32_SOURCE_SIGNAL && other->signal_number == source->signal_number)
+				shared = true;
+		}
+		if (!shared)
+			signal(source->signal_number, SIG_DFL);
+	}
+	if (loop->messages == source)
+		loop->messages = NULL;
+
+	source->removed = true;
+	source->handle = NULL;
+	source->deadline = 0;
+	wl_list_remove(&source->loop_link);
+	wl_list_init(&source->loop_link);
+	wl_list_remove(&source->link);
+	wl_list_insert(&loop->destroy_list, &source->link);
+	return 0;
+}
+
+static void
+process_destroy_list(struct wl_event_loop *loop)
+{
+	struct wl_event_source *source, *next;
+
+	wl_list_for_each_safe(source, next, &loop->destroy_list, link)
+		free(source);
+	wl_list_init(&loop->destroy_list);
+}
+
+WL_EXPORT struct wl_event_loop *
+wl_event_loop_create(void)
+{
+	struct wl_event_loop *loop = zalloc(sizeof *loop);
+	if (!loop)
+		return NULL;
+
+	loop->wake = CreateEventW(NULL, FALSE, FALSE, NULL);
+	if (!loop->wake) {
+		free(loop);
+		return NULL;
+	}
+	loop->timer = CreateWaitableTimerExW(NULL, NULL, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+	if (!loop->timer)
+		loop->timer = CreateWaitableTimerW(NULL, FALSE, NULL);
+	if (!loop->timer) {
+		CloseHandle(loop->wake);
+		free(loop);
+		return NULL;
+	}
+	wl_list_init(&loop->sources);
+	wl_list_init(&loop->check_list);
+	wl_list_init(&loop->idle_list);
+	wl_list_init(&loop->destroy_list);
+	wl_priv_signal_init(&loop->destroy_signal);
+	return loop;
+}
+
+WL_EXPORT void
+wl_event_loop_destroy(struct wl_event_loop *loop)
+{
+	wl_priv_signal_final_emit(&loop->destroy_signal, loop);
+
+	/* Sources the owner never removed are released with the loop, like the
+	 * epoll set in event-loop.c; their memory follows the same rule. */
+	while (!wl_list_empty(&loop->sources)) {
+		struct wl_event_source *source = wl_container_of(loop->sources.next, source, loop_link);
+		wl_event_source_remove(source);
+	}
+	process_destroy_list(loop);
+	CloseHandle(loop->timer);
+	CloseHandle(loop->wake);
+	free(loop);
+}
+
+static bool
+post_dispatch_check(struct wl_event_loop *loop)
+{
+	struct wl_event_source *source, *next;
+	bool needs_recheck = false;
+
+	wl_list_for_each_safe(source, next, &loop->check_list, link) {
+		int result = 0;
+		if (source->kind == WL_WIN32_SOURCE_FD)
+			result = source->func.fd(source->fd, 0, source->data);
+		else if (source->kind == WL_WIN32_SOURCE_HANDLE)
+			result = source->func.handle(source->handle, source->data);
+		if (result < 0)
+			wl_log("Source dispatch function returned negative value!\n");
+		needs_recheck |= result != 0;
+	}
+	return needs_recheck;
+}
+
+WL_EXPORT void
+wl_event_loop_dispatch_idle(struct wl_event_loop *loop)
+{
+	while (!wl_list_empty(&loop->idle_list)) {
+		struct wl_event_source *source = wl_container_of(loop->idle_list.next, source, link);
+		source->func.idle(source->data);
+		wl_event_source_remove(source);
+	}
+}
+
+static void
+dispatch_timers(struct wl_event_loop *loop)
+{
+	const int64_t now = qpc_now();
+	struct wl_event_source *source;
+
+	/* Collect first, so callbacks that re-arm timers do not fire them again in
+	 * this pass; then run in deadline order, as event-loop.c's heap does. */
+	wl_list_for_each(source, &loop->sources, loop_link) {
+		if (source->kind != WL_WIN32_SOURCE_TIMER || source->removed || !source->deadline || source->deadline > now)
+			continue;
+		source->due_deadline = source->deadline;
+		source->deadline = 0;
+		source->due = true;
+	}
+
+	for (;;) {
+		struct wl_event_source *next = NULL;
+		/* Re-scan each time: a callback may remove sources from the list. */
+		wl_list_for_each(source, &loop->sources, loop_link) {
+			if (source->kind == WL_WIN32_SOURCE_TIMER && source->due && (!next || source->due_deadline < next->due_deadline))
+				next = source;
+		}
+		if (!next)
+			return;
+		next->due = false;
+		next->func.timer(next->data);
+	}
+}
+
+/* Arms loop->timer for the earliest timer deadline. Returns false if none is armed. */
+static bool
+arm_loop_timer(struct wl_event_loop *loop)
+{
+	int64_t earliest = 0;
+	struct wl_event_source *source;
+
+	wl_list_for_each(source, &loop->sources, loop_link) {
+		if (source->kind == WL_WIN32_SOURCE_TIMER && source->deadline && (!earliest || source->deadline < earliest))
+			earliest = source->deadline;
+	}
+	if (!earliest) {
+		CancelWaitableTimer(loop->timer);
+		return false;
+	}
+
+	/* Negative due times are relative, in 100 ns units; at least one unit. */
+	int64_t remaining = earliest - qpc_now();
+	int64_t units = remaining <= 0 ? 1 : remaining * 10000000 / qpc_frequency();
+	LARGE_INTEGER due;
+	due.QuadPart = -(units > 0 ? units : 1);
+	return SetWaitableTimer(loop->timer, &due, 0, NULL, NULL, FALSE) != 0;
+}
+
+static void
+dispatch_signals(struct wl_event_loop *loop)
+{
+	struct wl_event_source *source, *next;
+
+	for (int signal_number = 0; signal_number < WL_WIN32_SIGNALS; ++signal_number) {
+		if (!InterlockedExchange(&pending_signals[signal_number], 0))
+			continue;
+		wl_list_for_each_safe(source, next, &loop->sources, loop_link) {
+			if (source->kind == WL_WIN32_SOURCE_SIGNAL && !source->removed && source->signal_number == signal_number)
+				source->func.signal(signal_number, source->data);
+		}
+	}
+	if (signal_wake)
+		ResetEvent(signal_wake);
+}
+
+WL_EXPORT int
+wl_event_loop_dispatch(struct wl_event_loop *loop, int timeout)
+{
+	HANDLE handles[MAXIMUM_WAIT_OBJECTS];
+	struct wl_event_source *owners[MAXIMUM_WAIT_OBJECTS];
+	struct wl_event_source *source;
+	DWORD count = 0;
+
+	wl_event_loop_dispatch_idle(loop);
+
+	handles[count] = loop->wake;
+	owners[count++] = NULL;
+	if (arm_loop_timer(loop)) {
+		handles[count] = loop->timer;
+		owners[count++] = NULL;
+	}
+	if (signal_wake) {
+		handles[count] = signal_wake;
+		owners[count++] = NULL;
+	}
+	wl_list_for_each(source, &loop->sources, loop_link) {
+		if (source->removed || !source->handle || !source->mask || count >= WL_WIN32_MAX_HANDLES)
+			continue;
+		handles[count] = source->handle;
+		owners[count++] = source;
+	}
+
+	const DWORD wakeMask = loop->messages ? QS_ALLINPUT : 0;
+	const DWORD waited = MsgWaitForMultipleObjectsEx(count, handles, timeout < 0 ? INFINITE : (DWORD)timeout, wakeMask, MWMO_INPUTAVAILABLE);
+	if (waited == WAIT_FAILED) {
+		errno = EINVAL;
+		return -1;
+	}
+
+	/* Timers first, as in event-loop.c, so other sources cannot cancel due timers. */
+	dispatch_timers(loop);
+	dispatch_signals(loop);
+
+	/* Every signaled handle is dispatched, not only the one that ended the wait.
+	 * The wait already consumed an auto-reset object's signal, so that one is
+	 * dispatched without re-checking. */
+	for (DWORD i = 0; i < count; ++i) {
+		struct wl_event_source *owner = owners[i];
+		if (!owner || owner->removed)
+			continue;
+		if (waited != WAIT_OBJECT_0 + i && WaitForSingleObject(handles[i], 0) != WAIT_OBJECT_0)
+			continue;
+		if (owner->kind == WL_WIN32_SOURCE_FD)
+			owner->func.fd(owner->fd, WL_EVENT_READABLE & owner->mask, owner->data);
+		else
+			owner->func.handle(owner->handle, owner->data);
+	}
+
+	if (loop->messages && !loop->messages->removed) {
+		MSG message;
+		if (PeekMessageW(&message, NULL, 0, 0, PM_NOREMOVE))
+			loop->messages->func.idle(loop->messages->data);
+	}
+
+	process_destroy_list(loop);
+	wl_event_loop_dispatch_idle(loop);
+	while (post_dispatch_check(loop))
+		;
+	return 0;
+}
+
+WL_EXPORT int
+wl_event_loop_get_fd(struct wl_event_loop *loop)
+{
+	/* No single descriptor represents the loop on Windows. */
+	errno = ENOSYS;
+	return -1;
+}
+
+WL_EXPORT void
+wl_event_loop_wake(struct wl_event_loop *loop)
+{
+	SetEvent(loop->wake);
+}
+
+WL_EXPORT void
+wl_event_loop_add_destroy_listener(struct wl_event_loop *loop,
+				   struct wl_listener *listener)
+{
+	wl_priv_signal_add(&loop->destroy_signal, listener);
+}
+
+WL_EXPORT struct wl_listener *
+wl_event_loop_get_destroy_listener(struct wl_event_loop *loop,
+				   wl_notify_func_t notify)
+{
+	return wl_priv_signal_get(&loop->destroy_signal, notify);
+}
+
+#endif /* _WIN32 */
