+/*
+ * Windows implementation of the libwayland-server display API.
+ *
+ * Windows has no Unix-socket transport with descriptor passing, so this build
+ * accepts no Wayland clients: adding sockets and creating clients fail with
+ * ENOTSUP. Everything a compositor uses without clients is real: the display,
+ * its event loop, globals (with names, versions and the global filter), serials,
+ * destroy/client-created signals, protocol loggers and run/terminate.
+ * Client and resource functions exist so protocol code links; without clients
+ * no resource is ever created, and they behave as on an empty client.
+ * The shared-memory buffer API likewise reports that no buffers exist.
+ */
+
+#ifdef _WIN32
+
+#include <errno.h>
+#include <stdarg.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "wayland-util.h"
+#include "wayland-private.h"
+#include "wayland-server-private.h"
+#include "wayland-server.h"
+
+struct wl_display {
+	struct wl_event_loop *loop;
+	bool run;
+	uint32_t next_global_name;
+	uint32_t serial;
+	struct wl_list global_list;
+	struct wl_list client_list;
+	struct wl_list protocol_loggers;
+	struct wl_priv_signal destroy_signal;
+	struct wl_priv_signal create_client_signal;
+	wl_display_global_filter_func_t global_filter;
+	void *global_filter_data;
+	size_t max_buffer_size;
+};
+
+struct wl_global {
+	struct wl_display *display;
+	const struct wl_interface *interface;
+	uint32_t name;
+	uint32_t version;
+	void *data;
+	wl_global_bind_func_t bind;
+	struct wl_list link;
+	bool removed;
+};
+
+/* Layout of the deprecated public struct (wayland-private.h hides it). */
+struct wl_resource {
+	struct wl_object object;
+	wl_resource_destroy_func_t destroy;
+	struct wl_list link;
+	struct wl_signal destroy_signal;
+	struct wl_client *client;
+	void *data;
+};
+
+struct wl_protocol_logger {
+	struct wl_list link;
+	wl_protocol_logger_func_t func;
+	void *user_data;
+};
