+#ifdef _WIN32
+/* Windows extensions (event-loop-win32.c). A handle source fires while the
+ * waitable kernel object is signaled. The message source fires when the calling
+ * thread's message queue has input; the callback is expected to pump it. */
+typedef int (*wl_event_loop_handle_func_t)(void *handle, void *data);
+
+struct wl_event_source *
+wl_event_loop_add_handle(struct wl_event_loop *loop,
+			 void *handle,
+			 wl_event_loop_handle_func_t func,
+			 void *data);
+
+struct wl_event_source *
+wl_event_loop_add_win32_messages(struct wl_event_loop *loop,
+				 wl_event_loop_idle_func_t func,
+				 void *data);
+
+/* Ends a blocking wl_event_loop_dispatch() from any thread. */
+void
+wl_event_loop_wake(struct wl_event_loop *loop);
+#endif
