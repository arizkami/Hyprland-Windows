diff --git a/src/eventLoop/backend/Win32.cpp b/src/eventLoop/backend/Win32.cpp
new file mode 100644
index 0000000..079d5e2
--- /dev/null
+++ b/src/eventLoop/backend/Win32.cpp
@@ -0,0 +1,131 @@
+#ifdef _WIN32
+
+#include "Backend.hpp"
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+
+#include <algorithm>
+#include <format>
+#include <unordered_map>
+
+using namespace Hyprutils::EventLoop;
+using namespace Hyprutils::Memory;
+
+// Windows has no pollable descriptor equivalent for arbitrary CRT fds, so this backend
+// provides timers and cross-thread wakeups. FD sources fail registration explicitly.
+
+static std::string systemError(const std::string& operation) {
+    return std::format("{}: Win32 error {}", operation, GetLastError());
+}
+
+struct CEventLoopBackend::SBackendState {
+    HANDLE                         timer = nullptr;
+    HANDLE                         wake  = nullptr;
+    std::unordered_map<uintptr_t, int> registrations;
+
+    ~SBackendState() {
+        if (timer)
+            CloseHandle(timer);
+        if (wake)
+            CloseHandle(wake);
+    }
+};
+
+std::expected<CUniquePointer<CEventLoopBackend>, std::string> CEventLoopBackend::create() {
+    CUniquePointer<CEventLoopBackend> backend{new CEventLoopBackend};
+    backend->m_state = makeUnique<SBackendState>();
+
+    backend->m_state->timer = CreateWaitableTimerExW(nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+    if (!backend->m_state->timer)
+        backend->m_state->timer = CreateWaitableTimerW(nullptr, FALSE, nullptr);
+    if (!backend->m_state->timer)
+        return std::unexpected(systemError("CreateWaitableTimer"));
+
+    backend->m_state->wake = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+    if (!backend->m_state->wake)
+        return std::unexpected(systemError("CreateEvent"));
+
+    return backend;
+}
+
+CEventLoopBackend::~CEventLoopBackend() = default;
+
+int CEventLoopBackend::fd() const {
+    return -1;
+}
+
+std::expected<void, std::string> CEventLoopBackend::addFD(uintptr_t sourceID, int fd, FdEventMask mask) {
+    if (m_state->registrations.contains(sourceID))
+        return std::unexpected("file descriptor source is already registered");
+    if (mask)
+        return std::unexpected("file descriptor sources are not supported on Windows");
+
+    m_state->registrations.emplace(sourceID, fd);
+    return {};
+}
+
+std::expected<void, std::string> CEventLoopBackend::updateFD(uintptr_t sourceID, int fd, FdEventMask mask) {
+    const auto registrationIt = m_state->registrations.find(sourceID);
+    if (registrationIt == m_state->registrations.end() || registrationIt->second != fd)
+        return std::unexpected("file descriptor source has been removed");
+    if (mask)
+        return std::unexpected("file descriptor sources are not supported on Windows");
+    return {};
+}
+
+void CEventLoopBackend::removeFD(uintptr_t sourceID, int fd) {
+    const auto registrationIt = m_state->registrations.find(sourceID);
+    if (registrationIt == m_state->registrations.end() || registrationIt->second != fd)
+        return;
+    m_state->registrations.erase(registrationIt);
+}
+
+std::expected<void, std::string> CEventLoopBackend::rearmFD(uintptr_t sourceID, int fd, FdEventMask mask) {
+    return {};
+}
+
+std::expected<void, std::string> CEventLoopBackend::armTimer(std::optional<std::chrono::steady_clock::time_point> deadline) {
+    if (!deadline) {
+        CancelWaitableTimer(m_state->timer);
+        return {};
+    }
+
+    auto remaining = *deadline - std::chrono::steady_clock::now();
+    if (remaining <= std::chrono::steady_clock::duration::zero())
+        remaining = std::chrono::nanoseconds{100};
+
+    // Negative due times are relative, in 100 ns units.
+    const auto    ticks = std::max<int64_t>(1, std::chrono::duration_cast<std::chrono::nanoseconds>(remaining).count() / 100);
+    LARGE_INTEGER due{};
+    due.QuadPart = -ticks;
+    if (!SetWaitableTimer(m_state->timer, &due, 0, nullptr, nullptr, FALSE))
+        return std::unexpected(systemError("SetWaitableTimer"));
+    return {};
+}
+
+void CEventLoopBackend::signalWake() {
+    SetEvent(m_state->wake);
+}
+
+std::expected<std::vector<SBackendEvent>, std::string> CEventLoopBackend::wait(int timeout, size_t maximumEvents) {
+    const HANDLE handles[] = {m_state->timer, m_state->wake};
+    const DWORD  waited    = WaitForMultipleObjects(2, handles, FALSE, timeout < 0 ? INFINITE : static_cast<DWORD>(timeout));
+    if (waited == WAIT_FAILED)
+        return std::unexpected(systemError("WaitForMultipleObjects"));
+
+    std::vector<SBackendEvent> result;
+    if (waited == WAIT_TIMEOUT || maximumEvents == 0)
+        return result;
+
+    // Report every signaled handle, as epoll would, not only the first.
+    if (waited == WAIT_OBJECT_0 || WaitForSingleObject(m_state->timer, 0) == WAIT_OBJECT_0)
+        result.push_back({.type = eBackendEventType::TIMER});
+    if (result.size() < maximumEvents && (waited == WAIT_OBJECT_0 + 1 || WaitForSingleObject(m_state->wake, 0) == WAIT_OBJECT_0))
+        result.push_back({.type = eBackendEventType::WAKE});
+    return result;
+}
+
+#endif
