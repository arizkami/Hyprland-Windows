+#include <windows.h>
+#include <fcntl.h>
+#include <io.h>
+
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <filesystem>
+#include <iostream>
+#include <thread>
+
+#include <gtest/gtest.h>
+
+using namespace Hyprutils::OS;
+using namespace Hyprutils::EventLoop;
+using namespace std::chrono_literals;
+
+// The test binary doubles as a child process: with HU_ECHO_ARGS set it prints each
+// argument on its own line, so quoting can be checked against the real CRT parser.
+static const bool s_echoChild = [] {
+    char*  value = nullptr;
+    size_t size  = 0;
+    if (_dupenv_s(&value, &size, "HU_ECHO_ARGS") != 0 || !value)
+        return false;
+    const bool echo = std::string_view(value) == "1";
+    free(value);
+    if (!echo)
+        return false;
+    for (int i = 1; i < __argc; ++i)
+        std::cout << "[" << __argv[i] << "]\n";
+    std::cerr << "stderr-line\n";
+    std::cout.flush();
+    std::exit(7);
+}();
+
+static std::string selfPath() {
+    char path[MAX_PATH]{};
+    GetModuleFileNameA(nullptr, path, MAX_PATH);
+    return path;
+}
+
+TEST(Win32, ProcessSyncQuotingEnvAndExitCode) {
+    CProcess process(selfPath(), {"plain", "with space", "quote\"inside", "trailing\\", "back\\\\slashes", ""});
+    process.addEnv("HU_ECHO_ARGS", "1");
+    ASSERT_TRUE(process.runSync());
+    EXPECT_EQ(process.stdOut(), "[plain]\r\n[with space]\r\n[quote\"inside]\r\n[trailing\\]\r\n[back\\\\slashes]\r\n[]\r\n");
+    EXPECT_EQ(process.stdErr(), "stderr-line\r\n");
+    EXPECT_EQ(process.exitCode(), 7);
+    EXPECT_GT(process.pid(), 0);
+}
+
+TEST(Win32, ProcessMissingBinaryFails) {
+    CProcess process("hyprutils-definitely-missing-binary.exe", {});
+    EXPECT_FALSE(process.runSync());
+}
+
+TEST(Win32, ProcessAsyncRedirectsStdout) {
+    int pipes[2] = {-1, -1};
+    ASSERT_EQ(_pipe(pipes, 4096, _O_BINARY | _O_NOINHERIT), 0);
+    CFileDescriptor readEnd{pipes[0]}, writeEnd{pipes[1]};
+
+    CProcess        process(selfPath(), {"async"});
+    process.addEnv("HU_ECHO_ARGS", "1");
+    process.setStdoutFD(writeEnd.get());
+    ASSERT_TRUE(process.runAsync());
+    writeEnd.reset();
+
+    std::string output;
+    char        buffer[256];
+    int         read = 0;
+    while ((read = _read(readEnd.get(), buffer, sizeof(buffer))) > 0)
+        output.append(buffer, read);
+    EXPECT_EQ(output, "[async]\r\n");
+}
+
+TEST(Win32, FileDescriptorPipeState) {
+    int pipes[2] = {-1, -1};
+    ASSERT_EQ(_pipe(pipes, 4096, _O_BINARY), 0);
+    CFileDescriptor readEnd{pipes[0]}, writeEnd{pipes[1]};
+
+    EXPECT_TRUE(readEnd.isValid());
+    EXPECT_EQ(readEnd.getFlags(), 0);
+    EXPECT_FALSE(readEnd.isReadable());
+    EXPECT_FALSE(readEnd.isClosed());
+
+    ASSERT_EQ(_write(writeEnd.get(), "x", 1), 1);
+    EXPECT_TRUE(readEnd.isReadable());
+
+    auto duplicate = readEnd.duplicate();
+    EXPECT_TRUE(duplicate.isValid());
+    EXPECT_NE(duplicate.get(), readEnd.get());
+
+    writeEnd.reset();
+    EXPECT_FALSE(writeEnd.isValid());
+    char byte = 0;
+    ASSERT_EQ(_read(readEnd.get(), &byte, 1), 1);
+    EXPECT_TRUE(readEnd.isClosed());
+
+    const int raw = readEnd.take();
+    EXPECT_FALSE(readEnd.isValid());
+    EXPECT_EQ(_close(raw), 0);
+}
+
+TEST(Win32, SemaphoreExcludesOtherThreads) {
+    std::atomic<bool> released = false, acquired = false;
+    std::thread       contender;
+    {
+        CSemaphore lock("win32_test");
+        contender = std::thread([&] {
+            CSemaphore other("win32_test");
+            acquired = true;
+            EXPECT_TRUE(released.load());
+        });
+        std::this_thread::sleep_for(100ms);
+        EXPECT_FALSE(acquired.load());
+        released = true;
+    }
+    contender.join();
+    EXPECT_TRUE(acquired.load());
+}
+
+TEST(Win32, ProcLockExclusiveAndRelease) {
+    const auto instance = "hu-win32-test-" + std::to_string(GetCurrentProcessId());
+    {
+        CProcLock first(std::string(instance), {{"display", "a"}});
+        ASSERT_TRUE(first.obtain(CProcLock::eProcLockFlags::EXCLUSIVE).has_value());
+        EXPECT_EQ(first.enumerate().size(), 1);
+
+        CProcLock same(std::string(instance), {{"display", "a"}});
+        const auto result = same.obtain(CProcLock::eProcLockFlags::EXCLUSIVE);
+        ASSERT_FALSE(result.has_value());
+        EXPECT_EQ(result.error(), CProcLock::eProcLockObtainingError::ALREADY_RUNNING);
+
+        CProcLock otherDisplay(std::string(instance), {{"display", "b"}});
+        EXPECT_TRUE(otherDisplay.obtain(CProcLock::eProcLockFlags::EXCLUSIVE).has_value());
+        EXPECT_EQ(first.enumerate().size(), 2);
+    }
+    CProcLock probe(std::string(instance), {});
+    EXPECT_TRUE(probe.enumerate().empty());
+}
+
+TEST(Win32, EventLoopTimersAndExecutor) {
+    auto loop = IEventLoop::create();
+    ASSERT_TRUE(loop.has_value());
+    EXPECT_EQ((*loop)->fd(), -1);
+
+    int  fired = 0;
+    auto timer = (*loop)->addTimer(20ms, [&](ITimer&) {
+        ++fired;
+        (*loop)->stop();
+    });
+
+    const auto start = std::chrono::steady_clock::now();
+    ASSERT_TRUE((*loop)->enterLoop().has_value());
+    EXPECT_EQ(fired, 1);
+    EXPECT_GE(std::chrono::steady_clock::now() - start, 15ms);
+
+    bool posted   = false;
+    auto executor = (*loop)->executor();
+    std::thread([executor] { executor->post([] {}); }).join();
+    executor->post([&] {
+        posted = true;
+        (*loop)->stop();
+    });
+    ASSERT_TRUE((*loop)->enterLoop().has_value());
+    EXPECT_TRUE(posted);
+}
+
+TEST(Win32, EventLoopRejectsFdSources) {
+    auto loop = IEventLoop::create();
+    ASSERT_TRUE(loop.has_value());
+    int pipes[2] = {-1, -1};
+    ASSERT_EQ(_pipe(pipes, 64, _O_BINARY), 0);
+    CFileDescriptor writeEnd{pipes[1]};
+    auto            source = (*loop)->addFD(CFileDescriptor{pipes[0]}, eEventMask::READABLE, [](IFDSource&, FdEventMask) {});
+    EXPECT_FALSE(source.has_value());
+}
