diff --git a/src/os/ProcessWin32.cpp b/src/os/ProcessWin32.cpp
new file mode 100644
index 0000000..1720505
--- /dev/null
+++ b/src/os/ProcessWin32.cpp
@@ -0,0 +1,256 @@
+#ifdef _WIN32
+
+#include <hyprutils/os/Process.hpp>
+
+#ifndef WIN32_LEAN_AND_MEAN
+#define WIN32_LEAN_AND_MEAN
+#endif
+#include <windows.h>
+#include <io.h>
+
+#include <algorithm>
+#include <array>
+#include <cwctype>
+#include <map>
+#include <thread>
+
+using namespace Hyprutils::OS;
+
+struct Hyprutils::OS::CProcess::impl {
+    std::string                                      binary, out, err;
+    std::vector<std::string>                         args;
+    std::vector<std::pair<std::string, std::string>> env;
+    pid_t                                            pid      = 0;
+    int                                              exitCode = 0, stdinFD = -1, stdoutFD = -1, stderrFD = -1;
+};
+
+struct SHandle {
+    HANDLE handle = nullptr;
+
+    SHandle() = default;
+    explicit SHandle(HANDLE h) : handle(h == INVALID_HANDLE_VALUE ? nullptr : h) {}
+    SHandle(const SHandle&)            = delete;
+    SHandle& operator=(const SHandle&) = delete;
+    ~SHandle() {
+        reset();
+    }
+    void reset(HANDLE h = nullptr) {
+        if (handle)
+            CloseHandle(handle);
+        handle = h;
+    }
+};
+
+static std::wstring wide(const std::string& text) {
+    if (text.empty())
+        return {};
+    const int    size = MultiByteToWideChar(CP_UTF8, 0, text.data(), static_cast<int>(text.size()), nullptr, 0);
+    std::wstring result(size, L'\0');
+    MultiByteToWideChar(CP_UTF8, 0, text.data(), static_cast<int>(text.size()), result.data(), size);
+    return result;
+}
+
+// Quotes one argument so CommandLineToArgvW / the MSVC CRT reproduce it exactly.
+static std::wstring quoteArgument(const std::wstring& argument) {
+    if (!argument.empty() && argument.find_first_of(L" \t\n\v\"") == std::wstring::npos)
+        return argument;
+
+    std::wstring result = L"\"";
+    for (size_t i = 0;; ++i) {
+        size_t backslashes = 0;
+        while (i < argument.size() && argument[i] == L'\\') {
+            ++i;
+            ++backslashes;
+        }
+
+        if (i == argument.size()) {
+            result.append(backslashes * 2, L'\\');
+            break;
+        }
+
+        if (argument[i] == L'"')
+            result.append(backslashes * 2 + 1, L'\\');
+        else
+            result.append(backslashes, L'\\');
+        result += argument[i];
+    }
+    return result + L'"';
+}
+
+static std::wstring commandLine(const std::string& binary, const std::vector<std::string>& args) {
+    std::wstring result = quoteArgument(wide(binary));
+    for (const auto& arg : args) {
+        result += L' ';
+        result += quoteArgument(wide(arg));
+    }
+    return result;
+}
+
+static std::wstring upper(std::wstring text) {
+    std::ranges::transform(text, text.begin(), [](wchar_t c) { return static_cast<wchar_t>(std::towupper(c)); });
+    return text;
+}
+
+// Environment names are case-insensitive on Windows; the block must be sorted that way.
+static std::wstring environmentBlock(const std::vector<std::pair<std::string, std::string>>& overrides) {
+    std::map<std::wstring, std::wstring> variables;
+    if (const auto block = GetEnvironmentStringsW()) {
+        for (auto entry = block; *entry; entry += wcslen(entry) + 1) {
+            const std::wstring_view text{entry};
+            const auto              equals = text.find(L'=', 1);
+            if (equals == std::wstring_view::npos)
+                continue;
+            const std::wstring name{text.substr(0, equals)};
+            variables[upper(name)] = std::wstring{text};
+        }
+        FreeEnvironmentStringsW(block);
+    }
+
+    for (const auto& [name, value] : overrides) {
+        const auto wideName      = wide(name);
+        variables[upper(wideName)] = wideName + L'=' + wide(value);
+    }
+
+    std::wstring result;
+    for (const auto& [_, entry] : variables) {
+        result += entry;
+        result += L'\0';
+    }
+    result += L'\0';
+    return result;
+}
+
+static std::string readAll(HANDLE pipe) {
+    std::string            result;
+    std::array<char, 4096> buffer{};
+    DWORD                  read = 0;
+    while (ReadFile(pipe, buffer.data(), static_cast<DWORD>(buffer.size()), &read, nullptr) && read > 0)
+        result.append(buffer.data(), read);
+    return result;
+}
+
+static HANDLE inheritableHandle(int fd) {
+    if (fd < 0)
+        return nullptr;
+    const auto handle = reinterpret_cast<HANDLE>(_get_osfhandle(fd));
+    if (handle == INVALID_HANDLE_VALUE)
+        return nullptr;
+    HANDLE duplicate = nullptr;
+    if (!DuplicateHandle(GetCurrentProcess(), handle, GetCurrentProcess(), &duplicate, 0, TRUE, DUPLICATE_SAME_ACCESS))
+        return nullptr;
+    return duplicate;
+}
+
+Hyprutils::OS::CProcess::CProcess(const std::string& binary, const std::vector<std::string>& args) : m_impl(new impl()) {
+    m_impl->binary = binary;
+    m_impl->args   = args;
+}
+
+Hyprutils::OS::CProcess::~CProcess() {
+    delete m_impl;
+}
+
+void Hyprutils::OS::CProcess::addEnv(const std::string& name, const std::string& value) {
+    m_impl->env.emplace_back(name, value);
+}
+
+bool Hyprutils::OS::CProcess::runSync() {
+    SECURITY_ATTRIBUTES security{sizeof(SECURITY_ATTRIBUTES), nullptr, TRUE};
+    HANDLE              outRead = nullptr, outWrite = nullptr, errRead = nullptr, errWrite = nullptr;
+    if (!CreatePipe(&outRead, &outWrite, &security, 0))
+        return false;
+    SHandle stdoutRead{outRead}, stdoutWrite{outWrite};
+    if (!CreatePipe(&errRead, &errWrite, &security, 0))
+        return false;
+    SHandle stderrRead{errRead}, stderrWrite{errWrite};
+    // Only the child ends are inherited.
+    SetHandleInformation(stdoutRead.handle, HANDLE_FLAG_INHERIT, 0);
+    SetHandleInformation(stderrRead.handle, HANDLE_FLAG_INHERIT, 0);
+
+    STARTUPINFOW startup{};
+    startup.cb         = sizeof(startup);
+    startup.dwFlags    = STARTF_USESTDHANDLES;
+    startup.hStdInput  = GetStdHandle(STD_INPUT_HANDLE);
+    startup.hStdOutput = stdoutWrite.handle;
+    startup.hStdError  = stderrWrite.handle;
+
+    auto                command     = commandLine(m_impl->binary, m_impl->args);
+    auto                environment = environmentBlock(m_impl->env);
+    PROCESS_INFORMATION info{};
+    if (!CreateProcessW(nullptr, command.data(), nullptr, nullptr, TRUE, CREATE_NO_WINDOW | CREATE_UNICODE_ENVIRONMENT, environment.data(), nullptr, &startup, &info))
+        return false;
+
+    SHandle process{info.hProcess}, thread{info.hThread};
+    m_impl->pid = static_cast<pid_t>(info.dwProcessId);
+    stdoutWrite.reset();
+    stderrWrite.reset();
+
+    // Drain both pipes concurrently so a full stderr buffer cannot block stdout.
+    std::string errors;
+    std::thread errorReader([&errors, handle = stderrRead.handle] { errors = readAll(handle); });
+    m_impl->out = readAll(stdoutRead.handle);
+    errorReader.join();
+    m_impl->err = std::move(errors);
+
+    WaitForSingleObject(process.handle, INFINITE);
+    DWORD code = 0;
+    GetExitCodeProcess(process.handle, &code);
+    m_impl->exitCode = static_cast<int>(code);
+    return true;
+}
+
+bool Hyprutils::OS::CProcess::runAsync() {
+    SHandle      input{inheritableHandle(m_impl->stdinFD)}, output{inheritableHandle(m_impl->stdoutFD)}, error{inheritableHandle(m_impl->stderrFD)};
+    STARTUPINFOW startup{};
+    startup.cb = sizeof(startup);
+    const bool redirect = input.handle || output.handle || error.handle;
+    if (redirect) {
+        startup.dwFlags    = STARTF_USESTDHANDLES;
+        startup.hStdInput  = input.handle ? input.handle : GetStdHandle(STD_INPUT_HANDLE);
+        startup.hStdOutput = output.handle ? output.handle : GetStdHandle(STD_OUTPUT_HANDLE);
+        startup.hStdError  = error.handle ? error.handle : GetStdHandle(STD_ERROR_HANDLE);
+    }
+
+    auto                command     = commandLine(m_impl->binary, m_impl->args);
+    auto                environment = environmentBlock(m_impl->env);
+    PROCESS_INFORMATION info{};
+    if (!CreateProcessW(nullptr, command.data(), nullptr, nullptr, redirect, CREATE_UNICODE_ENVIRONMENT | DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP, environment.data(),
+                        nullptr, &startup, &info))
+        return false;
+
+    // Detached: the process outlives this object, as with the POSIX double fork.
+    CloseHandle(info.hThread);
+    CloseHandle(info.hProcess);
+    m_impl->pid = static_cast<pid_t>(info.dwProcessId);
+    return true;
+}
+
+const std::string& Hyprutils::OS::CProcess::stdOut() {
+    return m_impl->out;
+}
+
+const std::string& Hyprutils::OS::CProcess::stdErr() {
+    return m_impl->err;
+}
+
+pid_t Hyprutils::OS::CProcess::pid() {
+    return m_impl->pid;
+}
+
+int Hyprutils::OS::CProcess::exitCode() {
+    return m_impl->exitCode;
+}
+
+void Hyprutils::OS::CProcess::setStdinFD(int fd) {
+    m_impl->stdinFD = fd;
+}
+
+void Hyprutils::OS::CProcess::setStdoutFD(int fd) {
+    m_impl->stdoutFD = fd;
+}
+
+void Hyprutils::OS::CProcess::setStderrFD(int fd) {
+    m_impl->stderrFD = fd;
+}
