+#ifdef _WIN32
+// A session-local named mutex gives the same scoped, cross-process exclusion as flock.
+CSemaphore::CSemaphore(const char* name) {
+    const auto mutexName = std::format("Local\\hu_{}", name);
+    m_handle             = CreateMutexA(nullptr, FALSE, mutexName.c_str());
+    if (!m_handle)
+        return;
+
+    const auto waited = WaitForSingleObject(m_handle, INFINITE);
+    if (waited != WAIT_OBJECT_0 && waited != WAIT_ABANDONED) {
+        CloseHandle(m_handle);
+        m_handle = nullptr;
+    }
+}
+
+CSemaphore::~CSemaphore() {
+    if (!m_handle)
+        return;
+    ReleaseMutex(m_handle);
+    CloseHandle(m_handle);
+}
