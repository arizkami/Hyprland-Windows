+// Backend --------------------------------------------------------------------
+
+static LRESULT CALLBACK displayWindowProc(HWND window, UINT message, WPARAM wparam, LPARAM lparam) {
+    if (message == WM_DISPLAYCHANGE || (message == WM_SETTINGCHANGE && wparam == SPI_SETWORKAREA) || message == WM_DPICHANGED) {
+        if (auto backend = reinterpret_cast<CWin32Backend*>(GetWindowLongPtrW(window, GWLP_USERDATA)))
+            backend->refreshOutputs();
+        return 0;
+    }
+    return DefWindowProcW(window, message, wparam, lparam);
+}
+
+Aquamarine::CWin32Backend::CWin32Backend(SP<CBackend> backend_) : backend(backend_) {
+    timerHandle = CreateWaitableTimerExW(nullptr, nullptr, CREATE_WAITABLE_TIMER_HIGH_RESOLUTION, TIMER_ALL_ACCESS);
+    if (!timerHandle)
+        timerHandle = CreateWaitableTimerW(nullptr, FALSE, nullptr);
+}
+
+Aquamarine::CWin32Backend::~CWin32Backend() {
+    outputs.clear();
+    if (window)
+        DestroyWindow(static_cast<HWND>(window));
+    if (timerHandle)
+        CloseHandle(timerHandle);
+}
+
+eBackendType Aquamarine::CWin32Backend::type() {
+    return AQ_BACKEND_WIN32;
+}
+
+bool Aquamarine::CWin32Backend::start() {
+    if (!timerHandle) {
+        backend->log(AQ_LOG_ERROR, "win32: cannot create a waitable timer");
+        return false;
+    }
+
+    // WM_DISPLAYCHANGE is broadcast to top-level windows only; message-only windows miss it.
+    WNDCLASSEXW windowClass{};
+    windowClass.cbSize        = sizeof(windowClass);
+    windowClass.lpfnWndProc   = displayWindowProc;
+    windowClass.hInstance     = GetModuleHandleW(nullptr);
+    windowClass.lpszClassName = L"AquamarineWin32Displays";
+    RegisterClassExW(&windowClass);
+    window = CreateWindowExW(WS_EX_TOOLWINDOW | WS_EX_NOACTIVATE, windowClass.lpszClassName, L"", WS_POPUP, 0, 0, 0, 0, nullptr, nullptr, windowClass.hInstance, nullptr);
+    if (!window) {
+        backend->log(AQ_LOG_ERROR, std::format("win32: cannot create the display notification window ({})", GetLastError()));
+        return false;
+    }
+    SetWindowLongPtrW(static_cast<HWND>(window), GWLP_USERDATA, reinterpret_cast<LONG_PTR>(this));
+    return true;
+}
+
+std::vector<SP<SPollFD>> Aquamarine::CWin32Backend::pollFDs() {
+    return {makeShared<SPollFD>(SPollFD{.fd = -1, .onSignal = [this]() { dispatchTimers(); }, .handle = timerHandle})};
+}
