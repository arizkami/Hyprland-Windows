+struct SMonitorInfo {
+    MONITORINFOEXW info{};
+    HMONITOR       handle = nullptr;
+};
+
+static BOOL CALLBACK collectMonitor(HMONITOR handle, HDC, LPRECT, LPARAM parameter) {
+    auto&        list = *reinterpret_cast<std::vector<SMonitorInfo>*>(parameter);
+    SMonitorInfo monitor;
+    monitor.handle      = handle;
+    monitor.info.cbSize = sizeof(monitor.info);
+    if (GetMonitorInfoW(handle, &monitor.info))
+        list.push_back(monitor);
+    return TRUE;
+}
+
+static std::vector<SP<SOutputMode>> displayModes(const std::wstring& device) {
+    DEVMODEW current{};
+    current.dmSize = sizeof(current);
+    const bool                    hasCurrent = EnumDisplaySettingsW(device.c_str(), ENUM_CURRENT_SETTINGS, &current);
+
+    std::vector<SP<SOutputMode>> modes;
+    DEVMODEW                     mode{};
+    mode.dmSize = sizeof(mode);
+    for (DWORD i = 0; EnumDisplaySettingsW(device.c_str(), i, &mode); ++i) {
+        if (mode.dmBitsPerPel != 32)
+            continue;
+        const Vector2D size{static_cast<double>(mode.dmPelsWidth), static_cast<double>(mode.dmPelsHeight)};
+        const auto     refresh = mode.dmDisplayFrequency > 1 ? mode.dmDisplayFrequency * 1000 : 60000;
+        if (std::ranges::any_of(modes, [&](const auto& m) { return m->pixelSize == size && m->refreshRate == refresh; }))
+            continue;
+        modes.emplace_back(makeShared<SOutputMode>(SOutputMode{
+            .pixelSize   = size,
+            .refreshRate = refresh,
+            .preferred   = hasCurrent && mode.dmPelsWidth == current.dmPelsWidth && mode.dmPelsHeight == current.dmPelsHeight &&
+                mode.dmDisplayFrequency == current.dmDisplayFrequency,
+        }));
+    }
+    return modes;
+}
+
+void Aquamarine::CWin32Backend::refreshOutputs() {
+    if (!ready)
+        return;
+
+    std::vector<SMonitorInfo> monitors;
+    EnumDisplayMonitors(nullptr, nullptr, collectMonitor, reinterpret_cast<LPARAM>(&monitors));
+
+    // Removed monitors: destroying the output emits its destroy event.
+    std::erase_if(outputs, [&](const SP<CWin32Output>& output) {
+        const bool gone = std::ranges::none_of(monitors, [&](const SMonitorInfo& m) { return output->deviceName == m.info.szDevice; });
+        if (gone)
+            backend->log(AQ_LOG_DEBUG, std::format("win32: monitor {} removed", output->name));
+        return gone;
+    });
+
+    for (const auto& monitor : monitors) {
+        const std::wstring device = monitor.info.szDevice;
+        auto               it     = std::ranges::find_if(outputs, [&](const auto& o) { return o->deviceName == device; });
+        const bool         added  = it == outputs.end();
+        SP<CWin32Output>   output = added ? SP<CWin32Output>(new CWin32Output(device, self)) : *it;
+
+        if (added) {
+            output->self = output;
+            // "\\.\DISPLAY1" -> "DISPLAY1": the name hyprctl and monitor rules use.
+            output->name = utf8(device.starts_with(L"\\\\.\\") ? device.substr(4) : device);
+
+            DISPLAY_DEVICEW adapterMonitor{};
+            adapterMonitor.cb = sizeof(adapterMonitor);
+            if (EnumDisplayDevicesW(device.c_str(), 0, &adapterMonitor, 0)) {
+                output->model       = utf8(adapterMonitor.DeviceString);
+                output->description = std::format("{} ({})", output->model, output->name);
+            }
+            if (HDC dc = CreateDCW(L"DISPLAY", device.c_str(), nullptr, nullptr)) {
+                output->physicalSize = {static_cast<double>(GetDeviceCaps(dc, HORZSIZE)), static_cast<double>(GetDeviceCaps(dc, VERTSIZE))};
+                DeleteDC(dc);
+            }
+            output->enabled = true;
+        }
+
+        const auto& rect        = monitor.info.rcMonitor;
+        output->desktopPosition = {static_cast<double>(rect.left), static_cast<double>(rect.top)};
+        output->modes           = displayModes(device);
+        UINT dpiX = 96, dpiY = 96;
+        if (SUCCEEDED(GetDpiForMonitor(monitor.handle, MDT_EFFECTIVE_DPI, &dpiX, &dpiY)))
+            output->dpiScale = dpiX / 96.0;
+
+        if (added) {
+            outputs.emplace_back(output);
+            backend->log(AQ_LOG_DEBUG, std::format("win32: monitor {} at {}x{}", output->name, rect.left, rect.top));
+            backend->events.newOutput.emit(SP<IOutput>(output));
+            output->scheduleFrame(IOutput::AQ_SCHEDULE_NEW_MONITOR);
+        }
+    }
+}
+
+void Aquamarine::CWin32Backend::addTimer(std::chrono::steady_clock::time_point when, std::function<void()> fn) {
+    timers.emplace_back(STimer{.when = when, .fn = std::move(fn)});
+    armTimer();
+}
+
+void Aquamarine::CWin32Backend::armTimer() {
+    if (timers.empty()) {
+        CancelWaitableTimer(timerHandle);
+        return;
+    }
+    const auto earliest  = std::ranges::min(timers, {}, &STimer::when).when;
+    const auto remaining = std::chrono::duration_cast<std::chrono::nanoseconds>(earliest - std::chrono::steady_clock::now()).count();
+    LARGE_INTEGER due{};
+    // Negative: relative due time in 100 ns units, at least one.
+    due.QuadPart = -std::max<int64_t>(1, remaining / 100);
+    SetWaitableTimer(timerHandle, &due, 0, nullptr, nullptr, FALSE);
+}
+
+void Aquamarine::CWin32Backend::dispatchTimers() {
+    const auto        now = std::chrono::steady_clock::now();
+    std::vector<STimer> due;
+    std::erase_if(timers, [&](STimer& timer) {
+        if (timer.when > now)
+            return false;
+        due.emplace_back(std::move(timer));
+        return true;
+    });
+    std::ranges::sort(due, {}, &STimer::when);
+    for (auto& timer : due)
+        timer.fn();
+    armTimer();
+}
+
