+// Output ---------------------------------------------------------------------
+
+Aquamarine::CWin32Output::CWin32Output(const std::wstring& deviceName_, CWeakPointer<CWin32Backend> backend_) : deviceName(deviceName_), backend(backend_) {
+    lastFrame = std::chrono::steady_clock::now();
+}
+
+Aquamarine::CWin32Output::~CWin32Output() {
+    events.destroy.emit();
+}
+
+bool Aquamarine::CWin32Output::commit() {
+    // DWM presents the desktop; the requested state is recorded, never applied to
+    // the display hardware (no ChangeDisplaySettings).
+    const auto snapshot = state->snapshot();
+    events.commit.emit();
+    state->consume(snapshot);
+    needsFrame = false;
+    events.present.emit(IOutput::SPresentEvent{.presented = true});
+    return true;
+}
+
+bool Aquamarine::CWin32Output::test() {
+    return true;
+}
+
+SP<IBackendImplementation> Aquamarine::CWin32Output::getBackend() {
+    return backend.lock();
+}
+
+std::vector<SDRMFormat> Aquamarine::CWin32Output::getRenderFormats() {
+    return backend->getRenderFormats();
+}
+
+bool Aquamarine::CWin32Output::pendingPageFlip() {
+    return false;
+}
+
+bool Aquamarine::CWin32Output::pendingIdleFrame() {
+    return frameScheduled;
+}
+
+void Aquamarine::CWin32Output::scheduleFrame(const scheduleFrameReason reason) {
+    needsFrame = true;
+
+    if (!framecb) {
+        framecb = makeShared<std::function<void()>>([this, weak = self]() {
+            if (!weak)
+                return;
+            frameScheduled = false;
+            lastFrame      = std::chrono::steady_clock::now();
+            events.frame.emit();
+        });
+    }
+
+    if (frameScheduled)
+        return;
+    frameScheduled = true;
+
+    int64_t refreshRatemHz = 60000;
+    auto&   currentState   = state->state();
+    if (currentState.mode && currentState.mode->refreshRate)
+        refreshRatemHz = currentState.mode->refreshRate;
+    else if (currentState.customMode && currentState.customMode->refreshRate)
+        refreshRatemHz = currentState.customMode->refreshRate;
+
+    const auto interval = std::chrono::nanoseconds(1000LL * 1000000000LL / refreshRatemHz);
+    const auto next     = lastFrame + interval;
+    if (std::chrono::steady_clock::now() >= next) {
+        backend->backend->addIdleEvent(framecb);
+        return;
+    }
+
+    backend->addTimer(next, [this, weak = self, next]() {
+        if (!weak)
+            return;
+        if (framecb && *framecb)
+            (*framecb)();
+        lastFrame = next;
+    });
+}
+
+bool Aquamarine::CWin32Output::destroy() {
+    // Physical monitors cannot be destroyed on request.
+    return false;
+}
